name: Test Build EXE (multi-version, no release)

on:
  workflow_dispatch:  # lo lanci a mano da GitHub Actions
  push:
    branches:
      - main          # togli se vuoi solo manuale

jobs:
  build:
    runs-on: windows-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          pip install pyinstaller

      - name: Build all versions from tia_exports
        shell: pwsh
        run: |
          # Backup dello spec originale
          Copy-Item "test.spec" "test.spec.bak" -Force

          # Prende tutti i tia_constants_* dentro /tia_exports/**/
          $tiaFiles = Get-ChildItem "tia_exports" -Recurse -Filter "tia_constants_*.py"

          if (-not $tiaFiles) {
            Write-Error "Nessun file tia_constants_*.py trovato in 'tia_exports'"
          }

          foreach ($file in $tiaFiles) {
            # Es: tia_constants_0_25_40_1 -> 0_25_40_1
            $version = $file.BaseName -replace '^tia_constants_',''
            Write-Host "=== Build per versione PLC $version ==="

            # 1) Copia quel tia_constants al posto di utils/exports/tia_constants.py
            Copy-Item $file.FullName "utils/exports/tia_constants.py" -Force

            # 2) Rigenera version_info.txt (usato da PyInstaller)
            python make_version_file.py

            # 3) Modifica il nome EXE nel test.spec:
            #    da PGS-X-Finder-Beta -> PGS-X-Finder-Beta-VERSIONE
            (Get-Content "test.spec.bak") -replace "PGS-X-Finder-Beta", "PGS-X-Finder-Beta-$version" |
              Set-Content "test.spec"

            # 4) Build con PyInstaller usando lo .spec modificato
            pyinstaller "test.spec" --noconfirm
          }

          # Ripristina lo spec originale a fine giro
          Copy-Item "test.spec.bak" "test.spec" -Force

      - name: Upload EXE as artifact
        uses: actions/upload-artifact@v4
        with:
          name: test-build-exe
          path: |
            dist/**/*.exe
            dist/**/*.dll
            dist/**/*.pyd

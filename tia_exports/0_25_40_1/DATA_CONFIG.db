DATA_BLOCK "DATA_CONFIG"
{ DB_Accessible_From_OPC_UA := 'FALSE' ;
 S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      PLCVersion { ExternalWritable := 'False'} : String["DIM_STRINGNAME"];   // scritto su Settings
      PLCVersion1 : Int;
      PLCVersion2 : Int;
      PLCVersion3 : Int;
      PLCVersion4 : Int;
      CFGVersion : Int;   // PLCVersion1 * 100 + PLCVersion2
      SerType : Int;   // tipo dati Deserialize
      SerCurrInd : Int;   // indice blocco corrente Deserialize
      SerCurrLast : Int;   // indice ultimo blocco Deserialize
      SerIndStat : Int;
      SerTotRot : Real;
      ConfigReqTime { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Time;   // NON USATO
      ConfigReqTimeout { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : ULInt;   // NON USATO
      ConfigAckTime { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Time;   // NON USATO
      ConfigAckTimeout { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : ULInt;   // NON USATO
      ConfigSaveReqTime : Time;
      ConfigSaveReqTimeout : ULInt;
      ConfigSaveReqStart : Bool;
      TabstatReqTime : Time;
      TabstatReqTimeout : ULInt;
      ProgReqHMITime : Time;
      ProgReqHMITimeout : ULInt;
      SaveConfigReq { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      SaveConfigCurrStep { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int;
      DeletingFile { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      SavingFile : Bool;   // Scrittura file su WebServer in corso
      DebugInd { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int;
      DebugInd2 { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int;
      Config_Header { ExternalWritable := 'False'} : Array[0.."MAX_HEADER"] of Int;   // SN,FileType,FileTypeVersion,FileVersion
      AxisFunInd : Array[0.."MAX_ASSEFUNIND"] of Int;
      InInd : Array[0.."MAX_STATOBOOL"] of Int;
      OutInd : Array[0.."MAX_STATOBOOL"] of Int;
      ParamString : Array[0.."MAX_PARAMSTRING"] of String["DIM_STRINGNAME"];
      ParamBool : Array[0.."MAX_PARAMBOOL"] of Bool;
      ParamInt : Array[0.."MAX_PARAMINT"] of Int;
      ParamRealCfg : Array[0.."MAX_PARAMREAL"] of Real;
      ParamReal : Array[0.."MAX_PARAMREAL"] of Real;
      ParamRealType : Array[0.."MAX_PARAMREAL"] of Int;
      ParamRealFC { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Array[0.."MAX_PARAMREAL"] of Real;
      ParamRealOffset : Array[0.."MAX_PARAMREAL"] of Real;
      IO_Name : Array[0.."MAX_IO"] of String["DIM_STRINGNAME"];
      IO_Param { S7_SetPoint := 'False'} : Array[0.."MAX_IO"] of "Type_IOParam";
      Axis_Name : Array[0.."MAX_ASSE"] of String["DIM_STRINGID"];
      Axis_Param { S7_SetPoint := 'False'} : Array[0.."MAX_ASSE"] of "Type_AxisParam";
      Axis { S7_SetPoint := 'False'} : Array[0.."MAX_ASSE"] of "Type_Axis";
      Input { S7_SetPoint := 'False'} : Array[0.."MAX_INPUT"] of "Type_Input";
      Input_Param { S7_SetPoint := 'False'} : Array[0.."MAX_INPUT"] of "Type_InputParam";
      Feedback { S7_SetPoint := 'False'} : Array[0.."MAX_FEEDBACK"] of "Type_Feedback";
      Feedback_Param { S7_SetPoint := 'False'} : Array[0.."MAX_FEEDBACK"] of "Type_FeedbackParam";
      PID { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : Array[0.."MAX_PID"] of "Type_PID";
      PID_Param { S7_SetPoint := 'False'} : Array[0.."MAX_PID"] of "Type_PIDParam";
      Output { S7_SetPoint := 'False'} : Array[0.."MAX_OUTPUT"] of "Type_Output";
      Output_Param { S7_SetPoint := 'False'} : Array[0.."MAX_OUTPUT"] of "Type_OutputParam";
      Motor { S7_SetPoint := 'False'} : Array[0.."MAX_MOTORE"] of "Type_Motor";
      Motor_Config : Array[0.."MAX_MOTORE"] of Bool;
      Motor_Selectable : Array[0.."MAX_MOTORE"] of Bool;
      Motor_LSInd : Array[0.."MAX_MOTORE"] of Int;
      Motor_LS2Ind : Array[0.."MAX_MOTORE"] of Int;
      Motor_CmdInd : Array[0.."MAX_MOTORE"] of Int;
      Motor_Cmd1Ind : Array[0.."MAX_MOTORE"] of Int;
      Motor_Cmd2Ind : Array[0.."MAX_MOTORE"] of Int;
      Motor_Cmd3Ind : Array[0.."MAX_MOTORE"] of Int;
      Motor_StatInd : Array[0.."MAX_MOTORE"] of Int;
      Motor_TRInd : Array[0.."MAX_MOTORE"] of Int;
      Motor_TR2Ind : Array[0.."MAX_MOTORE"] of Int;
      Motor_StartingInd : Array[0.."MAX_MOTORE"] of Int;
      Alarm_Name : Array[0.."MAX_ALARM"] of String["DIM_STRINGNAME"];
      Alarm_Param { S7_SetPoint := 'False'} : Array[0.."MAX_ALARM"] of "Type_AlarmParam";
      Stop_Num : Int;
      Stop_Name : Array[0.."MAX_STOP"] of String["DIM_STRINGNAME"];
      Stop_Ind : Array[0.."MAX_STOP"] of Int;
      Maint_Name : Array[0.."MAX_MAINT"] of String["DIM_STRINGNAME"];
      Maint_Param { S7_SetPoint := 'False'} : Array[0.."MAX_MAINT"] of "Type_MaintParam";
      Toolset_Name { S7_SetPoint := 'True'} : Array[0.."MAX_TOOLSET"] of String["DIM_STRINGNAME"];
      Toolset_Param { S7_SetPoint := 'False'} : Array[0.."MAX_TOOLSET"] of "Type_ToolsetParam";
      UM_FC : Array[0.."MAX_UM"] of Real;
      UM_FC_Met { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Array[0.."MAX_UM"] of Real;
      UM_FC_Imp { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Array[0.."MAX_UM"] of Real;
   END_VAR
   VAR RETAIN
      UM_Offset : Array[0.."MAX_UM"] of Real;
   END_VAR
   VAR 
      UM_Offset_Met { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Array[0.."MAX_UM"] of Real;
      UM_Offset_Imp { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Array[0.."MAX_UM"] of Real;
   END_VAR
   VAR RETAIN
      UM_NDec : Array[0.."MAX_UM"] of Int;
   END_VAR
   VAR 
      UM_NDec_Met { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Array[0.."MAX_UM"] of Int;
      UM_NDec_Imp { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Array[0.."MAX_UM"] of Int;
   END_VAR
   VAR RETAIN
      UM_Name : Array[0.."MAX_UM"] of String["DIM_STRINGUMNAME"];
   END_VAR
   VAR 
      UM_Name_Met { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Array[0.."MAX_UM"] of String["DIM_STRINGUMNAME"];
      UM_Name_Imp { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Array[0.."MAX_UM"] of String["DIM_STRINGUMNAME"];
   END_VAR
